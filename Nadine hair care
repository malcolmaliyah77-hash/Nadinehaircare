<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Restore Hair Care Products</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#fffdf8;
    color:#171915;
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

img{
    width:100%;
    display:block;
    object-fit:cover;
}

/* HEADER */

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(255,253,248,.96);
    border-bottom:1px solid #e7e1d5;
}

.nav{
    max-width:1150px;
    margin:auto;
    min-height:75px;
    padding:0 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
}

.logo-icon{
    width:43px;
    height:43px;
    border-radius:50%;
    background:#263523;
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:Georgia,serif;
    font-size:25px;
}

.logo-name{
    font-family:Georgia,serif;
    font-size:23px;
}

.logo-small{
    display:block;
    font-family:Arial,sans-serif;
    font-size:9px;
    letter-spacing:2px;
    color:#73796e;
    text-transform:uppercase;
}

.nav-links{
    display:flex;
    gap:28px;
    align-items:center;
    font-size:14px;
    font-weight:bold;
}

.nav-links a:hover{
    color:#6f8061;
}

.nav-button{
    border:1px solid #263523;
    border-radius:30px;
    padding:10px 18px;
}

.menu{
    display:none;
    font-size:27px;
    cursor:pointer;
}

/* HERO */

.hero{
    min-height:680px;
    background:
    linear-gradient(90deg,rgba(15,22,13,.82),rgba(15,22,13,.38)),
    url("https://images.unsplash.com/photo-1580618672591-eb180b1a973f?auto=format&fit=crop&w=1600&q=85")
    center/cover;
    display:flex;
    align-items:center;
}

.hero-content{
    max-width:1150px;
    width:100%;
    margin:auto;
    padding:80px 20px;
    color:white;
}

.eyebrow{
    color:#cdb66a;
    letter-spacing:3px;
    font-size:11px;
    font-weight:bold;
    margin-bottom:15px;
}

.hero h1{
    font-family:Georgia,serif;
    font-size:clamp(48px,8vw,88px);
    line-height:1.05;
    max-width:700px;
}

.hero h1 em{
    font-weight:normal;
}

.hero p{
    max-width:570px;
    font-size:18px;
    margin:25px 0;
    color:#eee;
}

.buttons{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    padding:14px 23px;
    border-radius:30px;
    font-weight:bold;
}

.btn-white{
    background:white;
    color:#263523;
}

.btn-outline{
    border:1px solid white;
    color:white;
}

/* TRUST */

.trust{
    background:#263523;
    color:white;
}

.trust-inner{
    max-width:1150px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    text-align:center;
}

.trust-item{
    padding:24px;
    border-right:1px solid rgba(255,255,255,.15);
}

.trust-item:last-child{
    border:0;
}

.trust-item strong{
    display:block;
    font-size:14px;
    letter-spacing:2px;
}

.trust-item span{
    color:#cbd2c4;
    font-size:12px;
}

/* GENERAL */

section{
    padding:100px 20px;
}

.container{
    max-width:1150px;
    margin:auto;
}

h2{
    font-family:Georgia,serif;
    font-size:clamp(38px,5vw,60px);
    line-height:1.15;
}

.muted{
    color:#6c7167;
}

/* ABOUT */

.about-grid{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:80px;
    align-items:center;
}

.about-text p{
    margin:18px 0;
    color:#6c7167;
}

.about-card{
    background:#e9ede2;
    border-radius:30px;
    padding:50px;
    min-height:330px;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
}

.about-card .star{
    font-size:40px;
    color:#6f8061;
    margin-bottom:auto;
}

.about-card h3{
    font-family:Georgia,serif;
    font-size:30px;
}

/* SERVICES */

.light{
    background:#f7f4ec;
}

.center{
    text-align:center;
}

.service-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:1px;
    margin-top:50px;
    border:1px solid #e7e1d5;
}

.service{
    padding:40px;
    background:#fffdf8;
}

.service-number{
    color:#c7a34c;
    font-weight:bold;
}

.service h3{
    font-family:Georgia,serif;
    font-size:29px;
    margin:25px 0 10px;
}

/* PRODUCTS */

.product-heading{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:30px;
    margin-bottom:50px;
}

.product-heading p{
    max-width:400px;
    color:#6c7167;
}

.products{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:25px;
}

.product{
    background:white;
    border:1px solid #e7e1d5;
}

.product-img{
    height:350px;
    background:#eee;
}

.product-img img{
    height:100%;
}

.product-info{
    padding:28px;
}

.product-label{
    color:#6f8061;
    font-size:10px;
    font-weight:bold;
    letter-spacing:2px;
}

.product h3{
    font-family:Georgia,serif;
    font-size:26px;
    margin:12px 0;
}

.product p{
    color:#6c7167;
    font-size:14px;
}

.product-link{
    display:inline-block;
    margin-top:18px;
